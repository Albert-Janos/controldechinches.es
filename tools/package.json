{
  "name": "controldechinches-seo-tools",
  "private": true,
  "type": "module",
  "description": "Local-only build, test and audit tooling. NOT deployed (see .deployignore).",
  "scripts": {
    "prices": "node build-prices.mjs",
    "check-prices": "node check-prices.mjs",
    "build": "node package-site.mjs --mode preview --out dist-preview",
    "package": "node package-site.mjs --mode production --out dist",
    "validate": "node validate.mjs --dir dist --mode production",
    "images": "node process-images.mjs",
    "serve": "node serve.mjs",
    "test": "node test-all.mjs",
    "preview": "node preview.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "axe-core": "4.14.1",
    "lighthouse": "13.6.0",
    "puppeteer-core": "25.19.0",
    "sharp": "0.35.5"
  }
}
